# Inside the session, /model switches between the models configured below.
# The session starts on the local model when there is one, otherwise on the first API model.

# --- Local model ---

# Path to the .gguf model file. A relative path starts at the folder of this file.
AGENT_CLI_MODEL_PATH=

# Optional. ip:port of a machine running ggml-rpc-server, to split the model across two machines.
# Leave empty to run everything on this machine.
AGENT_CLI_RPC_SERVERS=

# --- API models (any OpenAI-compatible API) ---

# Base URL of the API, for example https://openrouter.ai/api/v1
AGENT_CLI_API_BASE_URL=

# Secret key of your account on that API. Never commit it.
AGENT_CLI_API_KEY=

# Names of the models on that API, separated by commas. The first one is the default.
AGENT_CLI_API_MODELS=

# --- Context ---

# Optional. Size of the context, in tokens: the conversation and the reply have to fit in it.
# More tokens need more memory. A local model never gets more than the context it was trained with.
# llama.cpp uses contexts in steps of 256 tokens: a local model gets this value rounded down to a step,
# and never less than one step.
# Leave empty to use 8192.
AGENT_CLI_CONTEXT_TOKENS=8192

# --- System prompt ---

# Optional. Path to a text file with your system prompt, of any size. A relative path starts at the folder
# of this file.
# Leave empty to use the project's default prompt.
AGENT_CLI_SYSTEM_PROMPT_PATH=
