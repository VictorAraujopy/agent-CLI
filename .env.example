# Inside the session, /model switches between the models configured below.
# The session starts on the local model when there is one, otherwise on the first API model.

# --- Local model ---

# Path to the .gguf model file. A relative path starts at the folder of this file.
AGENT_CLI_MODEL_PATH=

# Optional. ip:port of a machine running ggml-rpc-server, to split the model across two machines.
# Leave empty to run everything on this machine.
AGENT_CLI_RPC_SERVERS=

# --- API models (OpenRouter) ---

# Secret key of your OpenRouter account. Never commit it.
AGENT_CLI_API_KEY=

# Names of the models on OpenRouter, written as OpenRouter lists them, separated by commas.
# The first one is the default.
AGENT_CLI_API_MODELS=

# --- System prompt ---

# Optional. Path to a text file with your system prompt, of any size. A relative path starts at the folder
# of this file.
# Leave empty to use the project's default prompt.
AGENT_CLI_SYSTEM_PROMPT_PATH=
